generator client {
    provider      = "prisma-client"
    output        = "../src/generated/prisma-client"
    moduleFormat  = "cjs"
    binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
    provider = "mysql"
}

enum USER_STATUS {
    ACTIVE
    INACTIVE
    BLOCKED
}

enum GENDER {
    MALE
    FEMALE
    OTHER
}

model User {
    id          String      @id @default(uuid())
    email       String      @unique
    username    String      @unique
    phoneNumber String?     @db.VarChar(20)
    avatar      String?     @db.VarChar(1000)
    birthday    DateTime?
    gender      GENDER?
    status      USER_STATUS @default(ACTIVE)

    // Trước đây là GROUP[]. MySQL không có kiểu mảng nên lưu JSON array
    // các giá trị enum GROUP, ví dụ ["ADMIN","SELLER"].
    // Hệ quả: bộ lọc hasSome không dùng được, xem user.repository.ts.
    group Json

    provinceId   Int?
    provinceName String? @db.VarChar(255)
    districtId   Int?
    districtName String? @db.VarChar(255)
    wardId       Int?
    wardName     String? @db.VarChar(255)
    address      String? @db.VarChar(1000)

    updatedById String?
    deletedById String?

    deletedAt DateTime?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    @@unique([email, deletedAt])
    @@unique([username, deletedAt])
    @@index([deletedAt])
    @@index([email])
    @@index([username])
    @@index([status])
}

enum HTTP_METHOD {
    GET
    POST
    PUT
    DELETE
    PATCH
    OPTIONS
    HEAD
}

enum GROUP {
    ADMIN
    SELLER
    CUSTOMER
}

model Permission {
    id          String      @id @default(uuid())
    name        String      @db.VarChar(500)
    description String      @default("")
    // VarChar(500) thay vì 1000: unique index [path, method, group] với utf8mb4
    // tốn 4 byte/ký tự, 1000 ký tự = 4000 byte, vượt giới hạn 3072 byte của InnoDB.
    // Path dài nhất trong dữ liệu thật là 46 ký tự.
    path        String      @db.VarChar(500)
    method      HTTP_METHOD
    module      String      @default("") @db.VarChar(500)
    group       GROUP       @default(CUSTOMER)

    createdById String?
    updatedById String?
    deletedById String?

    deletedAt DateTime?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    @@unique([path, method, group])
    @@index([deletedAt])
    @@index([group])
}
