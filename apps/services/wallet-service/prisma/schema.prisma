generator client {
    provider      = "prisma-client"
    output        = "../src/generated/prisma-client"
    moduleFormat  = "cjs"
    binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
    provider = "postgresql"
}

enum WalletTransactionType {
    CREDIT // tăng xu (nhận, nạp, hoàn)
    DEBIT // giảm xu (sử dụng, trừ)
}

enum WalletTransactionSource {
    ORDER_REWARD // tích xu từ đơn hàng hoàn tất
    REVIEW_REWARD // thưởng đánh giá sản phẩm
    PROMOTION_GIFT // quà sự kiện / sinh nhật / khuyến mãi
    REFERRAL // giới thiệu bạn bè
    TOPUP // nạp xu
    REFUND // hoàn xu khi huỷ đơn
    ORDER_PAYMENT // dùng xu thanh toán đơn
    SYSTEM // điều chỉnh thủ công bởi hệ thống / admin
    OTHER // khác
}

enum CreditTransactionType {
    CREDIT
    DEBIT
}

enum CreditTransactionSource {
    ORDER_REVENUE
    PLATFORM_FEE
    TAX_WITHHOLDING
    WITHDRAWAL
    REFUND
    SYSTEM
    OTHER
}

enum PayoutStatus {
    PENDING
    TRANSFERRED
    REJECTED
}

enum SellerSettlementStatus {
    PENDING
    PROCESSING
    SETTLED
    HELD
    CANCELLED
    FAILED
}

enum SellerSettlementAction {
    HOLD
    RELEASE
    CANCEL
}

model Wallet {
    id        String   @id @default(uuid())
    userId    String   @unique
    balance   Int      @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    transactions WalletTransaction[]

    @@index([userId])
}

model WalletTransaction {
    id           String                  @id @default(uuid())
    walletId     String
    wallet       Wallet                  @relation(fields: [walletId], references: [id], onDelete: Cascade)
    userId       String
    type         WalletTransactionType
    source       WalletTransactionSource @default(OTHER)
    referenceId  String? // orderId / reviewId / promotionId / paymentId...
    amount       Int // luôn dương
    balanceAfter Int
    description  String
    createdAt    DateTime                @default(now())

    @@index([userId, createdAt])
    @@index([walletId, createdAt])
    @@index([userId, source])
}

model Credit {
    id        String   @id @default(uuid())
    shopId    String   @unique
    balance   Int      @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    transactions CreditTransaction[]
    payouts      PayoutRequest[]
    settlements  SellerSettlement[]

    @@index([shopId])
}

model SellerSettlement {
    id                  String                 @id @default(uuid())
    orderId             String                 @unique
    shopId              String
    creditId            String?
    credit              Credit?                @relation(fields: [creditId], references: [id], onDelete: SetNull)
    grossAmount         Int
    commissionRate      Float
    commissionFee       Int
    taxRate             Float
    taxWithheld         Int
    netSellerAmount     Int
    status              SellerSettlementStatus @default(PENDING)
    completedAt         DateTime
    availableAt         DateTime
    processingStartedAt DateTime?
    settledAt           DateTime?
    heldAt              DateTime?
    heldBy              String?
    holdReason          String?
    releasedAt          DateTime?
    releasedBy          String?
    cancelledAt         DateTime?
    cancelledBy         String?
    cancelReason        String?
    attemptCount        Int                    @default(0)
    lastError           String?
    version             Int                    @default(0)
    createdAt           DateTime               @default(now())
    updatedAt           DateTime               @updatedAt

    histories SellerSettlementHistory[]

    @@index([status, availableAt])
    @@index([shopId, status, availableAt])
    @@index([processingStartedAt])
    @@index([completedAt])
    @@index([settledAt])
}

model SellerSettlementHistory {
    id           String                 @id @default(uuid())
    settlementId String
    settlement   SellerSettlement       @relation(fields: [settlementId], references: [id], onDelete: Cascade)
    action       SellerSettlementAction
    fromStatus   SellerSettlementStatus
    toStatus     SellerSettlementStatus
    reason       String?
    actorId      String
    createdAt    DateTime               @default(now())

    @@index([settlementId, createdAt])
    @@index([actorId, createdAt])
}

model CreditTransaction {
    id           String                  @id @default(uuid())
    creditId     String
    credit       Credit                  @relation(fields: [creditId], references: [id], onDelete: Cascade)
    shopId       String
    type         CreditTransactionType
    source       CreditTransactionSource @default(OTHER)
    referenceId  String?
    amount       Int
    balanceAfter Int
    description  String
    createdAt    DateTime                @default(now())

    @@unique([shopId, source, referenceId])
    @@index([shopId, createdAt])
    @@index([creditId, createdAt])
    @@index([shopId, source])
}

model PayoutRequest {
    id            String       @id @default(uuid())
    creditId      String
    credit        Credit       @relation(fields: [creditId], references: [id], onDelete: Cascade)
    shopId        String
    amount        Int
    bankName      String
    accountNumber String
    accountHolder String
    note          String?
    status        PayoutStatus @default(PENDING)
    rejectReason  String?
    processedAt   DateTime?
    createdAt     DateTime     @default(now())
    updatedAt     DateTime     @updatedAt

    @@index([shopId, createdAt])
    @@index([creditId, createdAt])
    @@index([shopId, status, createdAt])
}

model PlatformLedger {
    id              String   @id @default(uuid())
    orderId         String   @unique
    shopId          String
    grossAmount     Int      // Doanh thu gộp đơn hàng
    commissionRate  Float    @default(5.0) // Phí hoa hồng sàn (%)
    commissionFee   Int      // Phí hoa hồng thực thu
    taxRate         Float    @default(1.5) // Thuế nộp thay (%)
    taxWithheld     Int      @default(0)   // Thuế thực trừ
    netSellerAmount Int      // Số tiền thực nhận ví Seller
    createdAt       DateTime @default(now())

    @@index([shopId, createdAt])
    @@index([createdAt])
}
