generator client {
    provider      = "prisma-client"
    output        = "../src/generated/prisma-client"
    moduleFormat  = "cjs"
    binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
    provider = "postgresql"
}

enum WalletTransactionType {
    CREDIT // tăng xu (nhận, nạp, hoàn)
    DEBIT // giảm xu (sử dụng, trừ)
}

enum WalletTransactionSource {
    ORDER_REWARD // tích xu từ đơn hàng hoàn tất
    REVIEW_REWARD // thưởng đánh giá sản phẩm
    PROMOTION_GIFT // quà sự kiện / sinh nhật / khuyến mãi
    REFERRAL // giới thiệu bạn bè
    TOPUP // nạp xu
    REFUND // hoàn xu khi huỷ đơn
    ORDER_PAYMENT // dùng xu thanh toán đơn
    SYSTEM // điều chỉnh thủ công bởi hệ thống / admin
    OTHER // khác
}

enum CreditTransactionType {
    CREDIT
    DEBIT
}

enum CreditTransactionSource {
    ORDER_REVENUE
    WITHDRAWAL
    REFUND
    SYSTEM
    OTHER
}

enum PayoutStatus {
    PENDING
    TRANSFERRED
    REJECTED
}

model Wallet {
    id        String   @id @default(uuid())
    userId    String   @unique
    balance   Int      @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    transactions WalletTransaction[]

    @@index([userId])
}

model WalletTransaction {
    id           String                  @id @default(uuid())
    walletId     String
    wallet       Wallet                  @relation(fields: [walletId], references: [id], onDelete: Cascade)
    userId       String
    type         WalletTransactionType
    source       WalletTransactionSource @default(OTHER)
    referenceId  String? // orderId / reviewId / promotionId / paymentId...
    amount       Int // luôn dương
    balanceAfter Int
    description  String
    createdAt    DateTime                @default(now())

    @@index([userId, createdAt])
    @@index([walletId, createdAt])
    @@index([userId, source])
}

model Credit {
    id        String   @id @default(uuid())
    shopId    String   @unique
    balance   Int      @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    transactions CreditTransaction[]
    payouts      PayoutRequest[]

    @@index([shopId])
}

model CreditTransaction {
    id           String                  @id @default(uuid())
    creditId     String
    credit       Credit                  @relation(fields: [creditId], references: [id], onDelete: Cascade)
    shopId       String
    type         CreditTransactionType
    source       CreditTransactionSource @default(OTHER)
    referenceId  String?
    amount       Int
    balanceAfter Int
    description  String
    createdAt    DateTime                @default(now())

    @@unique([shopId, source, referenceId])
    @@index([shopId, createdAt])
    @@index([creditId, createdAt])
    @@index([shopId, source])
}

model PayoutRequest {
    id            String       @id @default(uuid())
    creditId      String
    credit        Credit       @relation(fields: [creditId], references: [id], onDelete: Cascade)
    shopId        String
    amount        Int
    bankName      String
    accountNumber String
    accountHolder String
    note          String?
    status        PayoutStatus @default(PENDING)
    rejectReason  String?
    processedAt   DateTime?
    createdAt     DateTime     @default(now())
    updatedAt     DateTime     @updatedAt

    @@index([shopId, createdAt])
    @@index([creditId, createdAt])
    @@index([shopId, status, createdAt])
}
