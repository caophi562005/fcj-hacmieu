{
  "enabled": true,
  "name": "UI/UX Skill Compliance Check",
  "description": "Automatically reviews edited files in admin-web, customer-web, and seller-web against the UI/UX Pro Max skill guidelines (no emoji icons, cursor-pointer on clickables, proper contrast, consistent spacing, accessibility, etc.)",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "apps/webs/admin-web/**/*.{tsx",
      "jsx",
      "ts",
      "js",
      "html",
      "css",
      "scss}",
      "apps/webs/customer-web/**/*.{tsx",
      "jsx",
      "ts",
      "js",
      "html",
      "css",
      "scss}",
      "apps/webs/seller-web/**/*.{tsx",
      "jsx",
      "ts",
      "js",
      "html",
      "css",
      "scss}"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Review the edited file against the UI/UX Pro Max skill rules in .kiro/steering/ui-ux-pro-max/SKILL.md. Check for: 1) No emoji icons (use SVG from Heroicons/Lucide instead), 2) cursor-pointer on all clickable elements, 3) Stable hover states (no layout shift), 4) Proper light/dark mode contrast, 5) Smooth transitions (150-300ms), 6) Consistent icon sizing, 7) Floating navbar spacing, 8) Accessibility (alt text, labels, color not sole indicator). If any violations are found, suggest fixes. If the file passes all checks, confirm compliance briefly."
  }
}